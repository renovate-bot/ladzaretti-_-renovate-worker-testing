{
  "dependencyDashboard": "true",
  "schedule": [
    "* 0-3 * * 1"
  ],
  "packageRules": [{
    "groupName": "prod",
    "matchPaths": ["prod/**/sub3"],
    "addLabels": ["prod"]
  },
    {
      "groupName": "dev",
      "matchPaths": ["dev/**/sub3"],
      "addLabels": ["dev"]
    },{
      "matchManagers": ["nodenv"],
      "ignoreUnstable": "false"
    }
  ]
  
}
